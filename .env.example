# Local development environment.
#
# Copy to `.env` and fill in. `.env` is git-ignored and never committed —
# `tests/static/secrets.test.ts` fails the build if it ever is.
#
# For staging and production these values come from the **EAS environment**
# (`eas env:create --environment preview …`), not from a file. A staging or
# production build with anything missing here fails at config-evaluation time
# rather than shipping a binary that silently falls back to a device-local
# identity — see `config/env.js`.

# NOTE: `APP_VARIANT` does not belong in this file. Expo exports only
# `EXPO_PUBLIC_*` into the environment `app.config.ts` is evaluated in, so
# setting it here has no effect. It comes from the shell (the npm scripts set
# it) or from the EAS build profile. Unset means **production**, deliberately:
# an unrecognised variant must not get the loosest rules.

# Which environment this configuration belongs to: development | staging | production.
# It must match APP_VARIANT, and it is the check that stops a staging build
# shipping with production's Firebase project.
EXPO_PUBLIC_ENV_NAME=development

# Firebase web configuration, from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the catalogue comes from: `mock` serves the launch seeds in the binary,
# `remote` reads published content and falls back to them if a fetch fails.
EXPO_PUBLIC_CONTENT_SOURCE=mock

# Development only. Point at the local emulator suite instead of any real
# project; with this set, the Firebase configuration above is not required.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=1

# Development only, and deliberate: anonymous sign-in creates real accounts, so
# a stray `npm run web` must not reach a live project just because credentials
# happen to be present. Set to 1 to opt in.
# EXPO_PUBLIC_ALLOW_LIVE_FIREBASE=1

# App Check, monitored but not enforced (ADR 22). Optional everywhere.
#
# Web only: the JS SDK attests with reCAPTCHA, which needs a DOM — on Android
# and iOS attestation is a native module the JS SDK cannot reach, so a mobile
# build reports `unsupported-platform` and its calls are counted as unverified.
# From the console: Project settings → App Check → Apps → Web → reCAPTCHA v3.
# EXPO_PUBLIC_APP_CHECK_RECAPTCHA_KEY=

# A debug token registered in the console lets a development build attest
# without a real site key. Per device, never committed.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
