rules_version = '2';

/**
 * Deny by default.
 *
 * Two rules of thumb this file is written against:
 *   1. Rules are not filters. A client query must carry constraints that match
 *      the condition here, or the whole query fails — see the notes on `seeds`.
 *   2. The privileged server SDK bypasses all of this, so anything that must be
 *      true of server writes is enforced in the Function, not here.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function staff(role) {
      return signedIn() && request.auth.token[role] == true;
    }

    function editorial() {
      return staff('admin') || staff('editor') || staff('reviewer');
    }

    /**
     * The reminder settings, validated by value and not only by key name.
     *
     * The allow-list said which keys could appear and nothing about what they
     * could contain: `pace` could be a map, `enabled` could be a string, and
     * `reminderTime` could be `"99:99"` or a megabyte of text. The scheduler
     * reads all three, so a document like that is a reminder that never fires
     * — written by the app itself, refused by nothing.
     *
     * This mirrors `NotificationPreferencesSchema` in
     * `packages/content-schema/src/sync.ts`. Rules cannot import it, so the two
     * are kept together by `firestore.test.ts`, which walks the same shapes.
     *
     * Firestore merges a dotted update into the existing map before the rule
     * sees it, so validating the whole map here also covers
     * `notificationPreferences.pace` written on its own.
     */
    function validReminderTime(value) {
      return value == null
        || (value is string
            && value.matches('^[0-9]{2}:[0-9]{2}$')
            && int(value[0:2]) < 24
            && int(value[3:5]) < 60);
    }

    function validNotificationPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasOnly(['pace', 'timeOfDay', 'reminderTime', 'enabled'])
        && prefs.keys().hasAll(['enabled'])
        && prefs.enabled is bool
        && (!('pace' in prefs) || prefs.pace == null || prefs.pace in ['one', 'two', 'whenever'])
        && (!('timeOfDay' in prefs)
            || prefs.timeOfDay == null
            || prefs.timeOfDay in ['morning', 'evening', 'night'])
        && (!('reminderTime' in prefs) || validReminderTime(prefs.reminderTime));
    }

    /**
     * A profile a client may write.
     *
     * The key allow-list alone left every *value* unconstrained: a locale could
     * be an object, a timezone could be a megabyte, and twenty interests could
     * each be a paragraph. Absent fields pass — this is a merge.
     */
    function validPreferences(data) {
      return (!('displayName' in data)
              || (data.displayName is string && data.displayName.size() <= 80))
        && (!('locale' in data) || data.locale in ['fa-IR', 'en'])
        && (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 64))
        && (!('interests' in data)
            || (data.interests is list && data.interests.size() <= 20))
        && (!('notificationPreferences' in data)
            || validNotificationPreferences(data.notificationPreferences))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 32));
    }

    // ---------------------------------------------------------------- catalogue
    // Published content is world-readable; nothing here is client-writable.
    // A client listing these must filter on `status == 'published'` itself.

    match /topics/{topicId} {
      allow get, list: if resource.data.status == 'published';
      allow write: if false;
    }

    match /paths/{pathId} {
      allow get, list: if resource.data.status == 'published';
      allow write: if false;
    }

    match /seeds/{seedId} {
      allow get, list: if resource.data.status == 'published';
      allow write: if false;
    }

    match /seedRevisions/{revisionId} {
      allow get, list: if resource.data.status == 'published';
      allow write: if false;
    }

    /**
     * The one public configuration document.
     *
     * Scoped to `public` by name rather than left open across the collection:
     * `appConfig` is where operational settings naturally accumulate, and the
     * next document added to it would have been world-readable by default.
     */
    match /appConfig/public {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{document} {
      allow read, write: if false;
    }

    /**
     * Rate-limit counters and App Check coverage.
     *
     * Both are written by the callable guard through the Admin SDK, which
     * bypasses these rules. A client that could read its own counter learns
     * exactly when to resume; one that could write it has no limit at all.
     */
    match /rateLimits/{bucket} {
      allow read, write: if false;
    }

    /**
     * The daily operating figure. Admin-readable so an operator can look
     * without a console query; written only by the scheduled function.
     */
    match /opsDigest/{day} {
      allow read: if staff('admin');
      allow write: if false;
    }

    match /appCheckCoverage/{day}/shards/{shard} {
      allow read: if staff('admin');
      allow write: if false;
    }

    // --------------------------------------------------------------- user data

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;

      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
             'displayName', 'locale', 'timezone', 'interests',
             'notificationPreferences', 'createdAt', 'updatedAt'
           ])
        && validPreferences(request.resource.data);

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'locale', 'timezone', 'interests',
             'notificationPreferences', 'updatedAt'
           ])
        && validPreferences(request.resource.data);

      // Deletion is a Function: it has to reach subcollections, Storage files
      // and push tokens, none of which a client delete would touch.
      allow delete: if false;

      /**
       * Progress is server-authoritative, derived from events.
       *
       * The client writes are kept for now and tightened in goal 7, but the
       * position and the schedule already come from the server — a client that
       * could write `blockIndex` could also move another device's reader.
       */
      /**
       * Progress, written by the server alone.
       *
       * The client used to be allowed to write here, validated field by field.
       * That contradicted the architecture: every progress change already
       * travels through the outbox into `ingestProgress`, which is idempotent
       * on event id and derives `percent`, `blockIndex` and the review schedule
       * itself. A client that could also write directly could set a completion
       * the server never counted, or move its resume position backwards past
       * the monotonic rule the ingest applies — two devices then disagreeing
       * with no event to reconcile from. There is exactly one writer. See
       * ADR 0022.
       */
      match /progress/{seedId} {
        allow read: if owner(uid);
        allow write: if false;
      }
      match /saved/{seedId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['seedId', 'saved', 'updatedAt'])
          && request.resource.data.seedId == seedId
          && request.resource.data.saved is bool
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 32;
        allow delete: if false;
      }

      /**
       * Review state is derived by `ingestProgress` from a `reviewed` event.
       *
       * Client-writable before, which let a device invent its own due date —
       * and a client that can write its own schedule can decide never to be
       * asked again. The attempt is still recorded by the reader, as an event.
       */
      match /reviews/{seedId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      /**
       * A device and its push token.
       *
       * Was `read, write: if owner(uid)` — anything of any shape or size. A
       * token is a capability to reach this reader's phone, so what may be
       * written is spelled out, and a document that carries anything else is
       * refused whole.
       */
      match /devices/{deviceId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
               'deviceId', 'pushToken', 'platform', 'appVersion', 'updatedAt'
             ])
          && request.resource.data.deviceId == deviceId
          && request.resource.data.pushToken is string
          && request.resource.data.pushToken.size() <= 256
          && request.resource.data.platform in ['ios', 'android', 'web']
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 32
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 32;
        // Signing out or uninstalling should be able to retire a token.
        allow delete: if owner(uid);
      }

      /** Server-authoritative aggregates: readable by their owner, never written. */
      match /daily/{date} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    /**
     * Deletion jobs. Written by the Function only.
     *
     * Not readable even by the owner: the document carries the receipt, which
     * is a capability that can finish the deletion without a session. A reader
     * asks about their own job through `myAccountDeletionStatus`, which
     * requires the receipt they were handed and answers with a state and
     * nothing else. Admins are excluded for the same reason.
     */
    match /deletionJobs/{uid} {
      allow read, write: if false;
    }

    match /userStats/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /entitlements/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /feeds/{uid}/items/{itemId} {
      allow read: if owner(uid);
      allow write: if false;
    }

    // ---------------------------------------------------------------- reporting

    /**
     * Reports arrive through the `submitReport` Function, never from a client.
     *
     * A report is retried from the outbox, so it has to be idempotent on the id
     * the device generated — which a client-side create cannot be without also
     * being allowed to update, and an updatable report is a rewritable one. The
     * uid, the received time and the triage state are all set server-side.
     */
    match /reports/{reportId} {
      allow create, update, delete: if false;
      allow read: if staff('reviewer') || staff('admin');
    }

    /**
     * Telemetry. Written by `recordTelemetryBatch`, read by staff.
     *
     * A client that could write here could forge a funnel or bury a crash; a
     * client that could read it would be reading every other reader's context.
     */
    match /telemetryEvents/{eventId} {
      allow write: if false;
      allow read: if staff('admin');
    }

    match /crashReports/{reportId} {
      allow write: if false;
      allow read: if staff('admin');
    }

    // ---------------------------------------------------------------------- CMS

    /**
     * Drafts.
     *
     * A client may write **content**, and nothing else. Every field that
     * decides whether content ships — the state, who wrote it, who approved it,
     * which revision it published — is set by `functions/src/publish/drafts.ts`
     * and is unwritable here.
     *
     * This is not belt-and-braces over the Function's checks. Rules and
     * Functions are separate doors: an editor with a REST client could
     * previously set `state: 'approved'` and `authorUid` on their own draft and
     * then ask the publish Function to ship it, which would pass every check
     * the Function makes, because the Function trusts the document.
     */
    match /cmsDrafts/{draftId} {
      allow read: if editorial();

      // The author is whoever is signed in, and a draft starts as a draft.
      allow create: if editorial()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.state == 'draft'
        && !request.resource.data.keys().hasAny([
             'reviewerUid', 'approvedBy', 'approvedAt',
             'publishedRevision', 'publishedAt', 'publishedBy'
           ]);

      /**
       * Editing is content only, by the author, while the draft is still
       * theirs to edit.
       *
       * Any editorial role could previously rewrite any draft, including one
       * already submitted by someone else — the trail would show the original
       * author against text they never wrote. An admin keeps an override,
       * because someone has to be able to fix a draft whose author has left.
       */
      allow update: if editorial()
        && (resource.data.authorUid == request.auth.uid || staff('admin'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seed', 'title', 'updatedAt'])
        && resource.data.state in ['draft', 'changes_requested'];

      allow delete: if staff('admin');
    }

    /**
     * The audit trail is written by the Function, never by a client.
     *
     * A reviewer who can create a review row can write "approved by someone
     * else" onto their own draft — which is exactly the rule the workflow
     * exists to enforce. Read-only here, for the history panel.
     */
    match /cmsReviews/{reviewId} {
      allow read: if editorial();
      allow write: if false;
    }

    /** Publish jobs are written by the pipeline only. */
    match /publishJobs/{jobId} {
      allow read: if editorial();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
