{
  "name": "wisdom-wafers",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "^57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.18.0",
    "i18next": "^26.4.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.29.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "admin": "npm --workspace @dananeh/admin run dev",
    "android": "APP_VARIANT=development expo run:android",
    "build:functions": "npm run check:node && npm run build:schema && npm --workspace @dananeh/functions run build",
    "build:schema": "npm --workspace @dananeh/content-schema run build",
    "check:android": "node scripts/check-android-native.mjs",
    "check:config": "node scripts/check-config.mjs",
    "emulators": "npm run build:functions && ./scripts/firebase-emulators.sh emulators:start --only auth,firestore,storage,functions",
    "emulators:lite": "./scripts/firebase-emulators.sh emulators:start --only auth,firestore,storage",
    "export:android": "APP_VARIANT=development expo export --platform android",
    "export:web": "APP_VARIANT=development expo export --platform web",
    "ios": "APP_VARIANT=development expo run:ios",
    "lint": "expo lint --max-warnings 0",
    "prebuild": "APP_VARIANT=development expo prebuild --platform android --clean",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "smoke:android": "./scripts/smoke-android.sh",
    "smoke:local": "node scripts/smoke-local.mjs",
    "start": "APP_VARIANT=development expo start",
    "test": "jest",
    "test:all": "npm run test && npm run test:emulator",
    "test:emulator": "./scripts/firebase-emulators.sh emulators:exec --only auth,firestore,storage \"jest -c jest.emulator.config.js --runInBand\"",
    "test:watch": "jest --watch",
    "typecheck": "npm run build:schema && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p packages/content-schema/tsconfig.json && tsc --noEmit -p functions/tsconfig.json && tsc --noEmit -p admin/tsconfig.json",
    "web": "APP_VARIANT=development expo start --web",
    "diagnose": "npm run build:functions && node scripts/diagnose.mjs",
    "docs:events": "node scripts/event-coverage.mjs",
    "check:events": "node scripts/event-coverage.mjs --check",
    "ux:audit": "node scripts/ux-audit.mjs",
    "check:e2e": "node scripts/check-maestro.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "bootstrap:project": "npm run build:schema && node scripts/bootstrap-project.mjs",
    "check:node": "node scripts/check-node.mjs"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "functions",
    "admin"
  ],
  "engines": {
    "node": ">=22 <23"
  }
}
