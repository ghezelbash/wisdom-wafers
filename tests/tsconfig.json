{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ],
      "@dananeh/content-schema": [
        "../packages/content-schema/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts"
  ]
}
